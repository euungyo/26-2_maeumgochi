# 이 파일을 복사해서 `.env`로 저장하면 설정을 바꿀 수 있어 (안 만들어도 아래 기본값으로 동작)
# .env는 git에 올라가지 않음

# Node 서버 포트 (ESP32가 접속할 포트)
PORT=3000

# Docker PostgreSQL 설정 (docker-compose.yml과 같이 씀)
POSTGRES_USER=maeumgochi
POSTGRES_PASSWORD=maeumgochi_local
POSTGRES_DB=maeumgochi
POSTGRES_PORT=5432

# Node 서버가 DB에 붙을 주소 (위 값과 맞춰야 함)
DATABASE_URL=postgres://maeumgochi:maeumgochi_local@localhost:5432/maeumgochi
